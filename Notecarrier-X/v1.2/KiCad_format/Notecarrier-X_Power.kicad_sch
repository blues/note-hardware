	)
	(text_box "DESIGN NOTE:\n\nPower Path:\n- Input current limit: 3.5A\n- 26mOhm reverse blocking transistor\n- 15mOhm battery transistor\n\nBuck Regulator:\n- 1.5MHz frequency\n- Input Voltage: 5V\n- Output Voltage: 3.3-4.2V\n- Peak current: 2.5A"
		(exclude_from_sim no)
