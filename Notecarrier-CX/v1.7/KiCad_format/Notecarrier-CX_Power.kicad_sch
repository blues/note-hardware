	(text_box "DESIGN NOTE:\n\nPower Path:\n- Input current limit: 3.5A\n- 26mOhm reverse blocking transistor\n- 15mOhm battery transistor\n\nBuck Regulator:\n- 1.5MHz frequency\n- Input Voltage: 4.5-5.5V\n- Output Voltage: 3.3-4.2V\n- Peak current: 1.6A"
		(exclude_from_sim no)
		(at 91.44 39.8272 0)
		(size -33.02 26.67)
		(margins 0.9525 0.9525 0.9525 0.9525)
